# Cloudflare Pages headers (2026-11-08, Krishna: nothing hidden from Google, no duplicates).
# The project's own address (aarigo-tech-website.pages.dev and its preview copies) is a copy of the real site.
# Keep it out of search so Google only indexes https://www.aaurigotech.com (every page's canonical points there too).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# 2026-11-09 (Krishna: the How we work video, fast to load): the video files and poster are kept by browsers for a week,
# so a second visit does not download them again. Give a changed video a new file name.
/media/video/*
  Cache-Control: public, max-age=604800

# 2026-11-09 (Krishna: fix the Google Fonts request): our own font files, kept by browsers for a year.
# They never change under the same name; a new font version gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
